# Web app: Groq is the default OpenAI-compatible provider.
AI_PROVIDER=groq
AI_API_KEY=your_groq_api_key_here
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-20b

# Dedicated Groq key for multi-stage Agent Workflows (falls back to AI_API_KEY if omitted).
AI_AGENT_API_KEY=your_second_groq_api_key_here
AI_AGENT_BASE_URL=https://api.groq.com/openai/v1
AI_AGENT_MODEL=openai/gpt-oss-20b

# Alternative: OpenRouter free models. Set the model ID from its current model list.
# AI_PROVIDER=openrouter
# AI_API_KEY=your_openrouter_api_key_here
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=provider/model:free

# Legacy CLI only (main.py)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Firebase Authentication
# Public Web SDK values (safe to expose in browser; never put a service account here).
FIREBASE_API_KEY=your_firebase_web_api_key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_APP_ID=your_firebase_web_app_id
# Optional Web SDK settings:
# FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
# FIREBASE_MESSAGING_SENDER_ID=your_sender_id

# Server-only Firebase Admin service-account JSON, stored as one JSON string in Vercel.
# Never commit the real value. In production add it as FIREBASE_SERVICE_ACCOUNT_JSON.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
